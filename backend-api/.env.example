# ========================================================
# Configurações do Servidor
# ========================================================
PORT=4000
NODE_ENV=development
MASTER_API_KEY=secret-outlet-looker-token-2026

# ========================================================
# Autenticação Google Workspace OAuth2 (SSO Corporativo)
# ========================================================
# Crie as credenciais no Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=/api/auth/google/callback
ALLOWED_GOOGLE_DOMAINS=secretoutlet.com.br
ALLOWED_GOOGLE_EMAILS=admin@secretoutlet.com.br,marketing@secretoutlet.com.br,diretoria@secretoutlet.com.br
SESSION_SECRET=secret-metrics-super-secure-session-key-2026
DEV_LOGIN_ENABLED=true

# ========================================================
# E-commerce Secret Outlet (Shopify)
# ========================================================
SHOPIFY_SHOP_DOMAIN=secretoutlet.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# ========================================================
# E-commerce Secret Outlet (Bagy)
# ========================================================
BAGY_API_URL=https://api.bagy.com.br/v1
BAGY_API_TOKEN=bagy_token_xxxxxxxxxxxxxxx
BAGY_STORE_ID=12345

# ========================================================
# Tráfego Pago (Meta Ads)
# ========================================================
META_ACCESS_TOKEN=EAABxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=act_123456789012345

# ========================================================
# Tráfego Pago (Google Ads)
# ========================================================
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxx
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=xxxxxxxxxxxxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ========================================================
# Tráfego Pago (Criteo Ads)
# ========================================================
CRITEO_CLIENT_ID=xxxxxxxxxxxxxx
CRITEO_CLIENT_SECRET=xxxxxxxxxxxxxx
CRITEO_ADVERTISER_ID=12345

# ========================================================
# Tráfego Orgânico & SEO (GA4 & Search Console)
# ========================================================
GA4_PROPERTY_ID=123456789
GA4_CREDENTIALS_JSON=
GSC_SITE_URL=https://www.secretoutlet.com.br
GSC_CREDENTIALS_JSON=
